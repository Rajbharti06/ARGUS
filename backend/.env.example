# ARGUS v6.1 — Environment Configuration
# Copy this file to .env and fill in your API keys.
# All AI modules work without keys (rule-based fallback).
# Add keys to unlock live AI reasoning for each module.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━


# ─────────────────────────────────────────────────────────────────────────────
# NVIDIA NIM  ·  FREE SHOWCASE TIER  ← START HERE
# ─────────────────────────────────────────────────────────────────────────────
# Sign up FREE: https://build.nvidia.com (takes 2 minutes)
# Free tier: 1,000 API calls/month — perfect for demos
# Powers: VEIL (phishing), HUNT (threat hunting), Sentinel analysis
# Model: nvidia/llama-3.3-nemotron-super-49b-v1 (49B — enterprise-grade)
NVIDIA_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# ANTHROPIC CLAUDE  ·  BEST FOR DEEP REASONING
# ─────────────────────────────────────────────────────────────────────────────
# Get key: https://console.anthropic.com
# Powers: ORACLE (attack chain), BREACH-IQ, IEM — best reasoning available
# Models used: claude-opus-4-7 (analysis) / claude-sonnet-4-6 (speed)
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# OPENAI GPT  ·  GOLD STANDARD
# ─────────────────────────────────────────────────────────────────────────────
# Get key: https://platform.openai.com
# Powers: ORACLE (o4-mini reasoning), all modules as fallback
# Models used: gpt-4o / o4-mini (reasoning tasks)
OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE GEMINI  ·  FREE TIER AVAILABLE  ·  1M TOKEN CONTEXT
# ─────────────────────────────────────────────────────────────────────────────
# Get key FREE: https://aistudio.google.com/app/apikey
# Powers: Large log analysis, ORACLE, BREACH-IQ — generous free tier
# Models used: gemini-2.5-pro (analysis) / gemini-2.0-flash (speed)
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# XAI GROK  ·  LIVE INTERNET ACCESS
# ─────────────────────────────────────────────────────────────────────────────
# Get key: https://console.x.ai
# Powers: Threat Intel (live X/web feeds), ORACLE, emerging threat analysis
# Models used: grok-3 / grok-3-mini
XAI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# PERPLEXITY SONAR  ·  LIVE WEB SEARCH — BEST FOR THREAT INTEL
# ─────────────────────────────────────────────────────────────────────────────
# Get key: https://www.perplexity.ai/settings/api
# Powers: Threat Intelligence module — searches live web for current CVEs,
#         threat actors, IOCs. Best provider for real-time intelligence.
# Models used: sonar-pro (live web) / sonar (faster)
PERPLEXITY_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# THREAT INTELLIGENCE APIs  (all free tiers available)
# ─────────────────────────────────────────────────────────────────────────────
ABUSEIPDB_API_KEY=      # https://www.abuseipdb.com         1,000 IP checks/day free
GREYNOISE_API_KEY=      # https://www.greynoise.io          Community free tier
NVD_API_KEY=            # https://nvd.nist.gov/developers   Higher rate limits (optional)
SHODAN_API_KEY=         # https://account.shodan.io         Asset exposure scanning
VIRUSTOTAL_API_KEY=     # https://www.virustotal.com        File/URL/IP reputation
HIBP_API_KEY=           # https://haveibeenpwned.com        Breach credential checks

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — FEATHERLESS (open-source model hosting)
# ─────────────────────────────────────────────────────────────────────────────
FEATHERLESS_API_KEY=    # https://featherless.ai

# ─────────────────────────────────────────────────────────────────────────────
# AUTH (not required for local development)
# ─────────────────────────────────────────────────────────────────────────────
# AUTH0_DOMAIN=your-domain.auth0.com
# AUTH0_AUDIENCE=https://argus-api
# AUTH0_CLIENT_ID=your-client-id
