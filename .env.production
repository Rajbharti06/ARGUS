# ARGUS — Production Environment Configuration
# Copy to .env and fill in your API keys

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://argus:argus_pass@postgres:5432/argus
USE_POSTGRES=true

# ── Application ──────────────────────────────────────────────────────────────
ARGUS_DEV_MODE=false
ARGUS_LOG_LEVEL=INFO

# ── AI Providers ─────────────────────────────────────────────────────────────
# Required: get a free key at https://featherless.ai
FEATHERLESS_API_KEY=

# Optional: https://build.nvidia.com
NVIDIA_API_KEY=

# Optional AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Authentication ───────────────────────────────────────────────────────────
# Create an app at https://auth0.com and fill these
AUTH0_DOMAIN=your-domain.auth0.com
AUTH0_AUDIENCE=https://argus-api
AUTH0_CLIENT_ID=
